# [Input] Dream/Backend public origins and the Admin-registered Dream service identity.
# [Output] Secret-free template for the server-only Next.js BFF and same-origin backend proxy.
# [Pos] Frontend deployment template; no database credential or OAuth authority secret belongs here.
# [Sync] 2026-09-16: align the local browser, Admin issuer, Google callback and Dream resource on localhost.
# [Sync] 2026-09-16: define the Admin DTO/BFF consumer configuration after the database cutover.

# Private Python backend reached only by Next Route Handlers.
INK_BACKEND_INTERNAL_URL=http://127.0.0.1:8765

# Public Dream origin and metadata base.
INK_PUBLIC_SITE_URL=http://localhost:5173
INK_DREAM_PUBLIC_ORIGIN=http://localhost:5173
INK_DREAM_BFF_REDIRECT_URI=http://localhost:5173/auth/callback
INK_DREAM_BFF_COOKIE_SECRET=
INK_DREAM_BFF_LOGIN_TTL_SECONDS=600

# Admin authentication and strict DTO service boundary. The service secret is
# server-only and must match one Admin DREAM_DATA_SERVICE_CLIENTS registration.
INK_ADMIN_DREAM_BASE_URL=http://localhost:3000
INK_ADMIN_AUTH_ISSUER=http://localhost:3000/api/auth
INK_DREAM_API_RESOURCE=http://localhost:5173/api
INK_ADMIN_DREAM_SERVICE_CLIENT_ID=ink-dream-service
INK_ADMIN_DREAM_SERVICE_SECRET=
INK_ADMIN_DREAM_TIMEOUT_SECONDS=10
INK_ADMIN_DREAM_MAX_RESPONSE_BYTES=1048576
