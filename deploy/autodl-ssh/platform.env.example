# [Input] AutoDL SSH endpoint and SeetaCloud public service mappings.
# [Output] Secret-free operator defaults for the Dream direct-host release.
# [Pos] AutoDL deployment configuration example; secrets stay in generated .env.
# [Sync] 2026-08-26: document the root Dream runtime and isolated Admin identity.
# [Sync] 2026-08-30: document the qualified Linux x64 Runtime package and absolute Dream CLI path.
# [Sync] 2026-08-30: note that prepare-env.sh fixes INK_AGENT_SANDBOX_ENABLED=false; it is not an operator knob here.
# [Sync] 2026-09-06: document the separate HTTPS MCP Apps sandbox origin and
#                    canonical Next.js/pnpm direct-host runtime.
# [Sync] 2026-09-11: point the public-origin placeholders at the AutoDL-injected service variables.
# [Sync] 2026-09-13: point the optional local-core package override at Runtime 0.1.8.

AUTODL_SSH_HOST=connect.example.com
AUTODL_SSH_USER=root
AUTODL_SSH_PORT=22
# Keep yes for key/control-socket automation. Set no only for an interactive password session.
AUTODL_SSH_BATCH_MODE=yes
# Optional when reusing an authenticated SSH control socket.
# AUTODL_SSH_CONTROL_PATH=/tmp/ink-autodl-ssh/control
AUTODL_APP_ROOT=/root/ink-autodl/dream
AUTODL_DATA_ROOT=/root/autodl-tmp/ink-memory
INK_AUTODL_ADMIN_HOME=/root/ink-autodl/data
AUTODL_SERVICE_USER=root
AUTODL_DREAM_BACKEND_BIND_HOST=127.0.0.1
AUTODL_DREAM_FRONTEND_PORT=6006
AUTODL_DREAM_BACKEND_PORT=8765
AUTODL_ADMIN_PORT=6008
# Real values come from the AutoDL-injected read-only service variables:
#   source /etc/profile.d/autodl.env.sh
#   AutoDLService6006URL (frontend 6006) -> AUTODL_DREAM_PUBLIC_ORIGIN
#   AutoDLService6008URL (Admin 6008)    -> AUTODL_ADMIN_PUBLIC_ORIGIN
# Print only those two variables; the profile file contains AutoDL panel tokens.
AUTODL_DREAM_PUBLIC_ORIGIN=https://dream-tunnel.example.com:8443
AUTODL_ADMIN_PUBLIC_ORIGIN=https://admin-tunnel.example.com:8443
# Must be a separate HTTPS origin routed to the same Dream Next.js service.
AUTODL_MCP_APPS_SANDBOX_ORIGIN=https://dream-sandbox.example.com:8443
# Server-owned MCP Apps policy/manifest input; keep this local file private.
AUTODL_MCP_APPS_ENV_FILE=/absolute/path/to/frontend/.env.local
AUTODL_CLAUDE_CODE_CLI_PATH=/root/ink-autodl/runtime/npm/bin/ink-claude-code-dream
# prepare-env.sh always emits INK_AGENT_SANDBOX_ENABLED=false on AutoDL.

# Defaults resolve to the sibling Runtime repository and its ignored,
# Docker-qualified Linux x64 package output. Override only when stored elsewhere.
# AUTODL_CLAUDE_RUNTIME_REPOSITORY=/absolute/path/to/ink-claude-code-dream
# AUTODL_CLAUDE_RUNTIME_PACKAGE_ROOT=/absolute/path/to/ink-claude-code-dream/dist/core-package-linux-x64/ink-claude-code-dream-0.1.8

# Optional trusted artifact seed for a first deployment. Existing remote
# artifacts are preserved when this directory is absent.
# AUTODL_PLUGIN_ARTIFACTS_SOURCE=/absolute/path/to/claude-plugin-runtime/artifacts

# Optional private npm access. Pass this through the process environment only;
# deploy.sh uploads a temporary mode-0600 npmrc and removes it after install.
# AUTODL_NPM_TOKEN=
