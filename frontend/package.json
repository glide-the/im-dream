{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "build:docker": "INK_NEXT_OUTPUT=standalone next build --webpack",
    "e2e:deck": "playwright test e2e/deck-dream.spec.ts --reporter=line --workers=1",
    "e2e:claude-plugins": "playwright test e2e/claude-plugin-settings.spec.ts --reporter=line --workers=1",
    "e2e:mcp-apps-phase0": "playwright test e2e/mcp-apps/phase-0 --reporter=line --workers=1",
    "e2e:mcp-apps-phase1": "playwright test e2e/mcp-apps/phase-1 --reporter=line --workers=1",
    "test:mcp-apps-runtime": "pnpm --filter @ink-dream/mcp-apps-runtime test",
    "typecheck:mcp-apps": "pnpm --filter @ink-dream/mcp-apps-runtime typecheck && tsc --noEmit -p packages/mcp-apps-runtime/tsconfig.integration.json",
    "lint": "eslint .",
    "preview": "next start"
  },
  "dependencies": {
    "@ink-dream/mcp-apps-runtime": "workspace:*",
    "@ai-sdk/react": "^3.0.193",
    "@mcp-ui/client": "7.1.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tiptap/extension-highlight": "^3.6.2",
    "@tiptap/extension-placeholder": "^3.7.2",
    "@tiptap/markdown": "^3.27.1",
    "@tiptap/react": "^3.6.2",
    "@tiptap/starter-kit": "^3.6.2",
    "ai": "^6.0.191",
    "html-to-image": "^1.11.13",
    "i18next": "^24.0.0",
    "mermaid": "^11.16.0",
    "next": "16.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.0.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "react-grab": "^0.1.37",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
