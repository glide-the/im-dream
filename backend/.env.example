# Ink & Memory Claude Agent environment template.
# Copy this file to backend/.env and fill real values locally. Do not commit secrets.

# PostgreSQL-only runtime. Set DATABASE_URL directly, or point to an env file
# from which Dream loads only DATABASE_URL and no other credentials.
DATABASE_URL=
INK_LOAD_DATABASE_URL_FROM_ENV_FILE=0
INK_DATABASE_ENV_FILE=

# =============================================================================
# 1. Claude Code SDK compatibility variables
# =============================================================================
# Admin Gateway-enabled runtime overwrites authentication, Base URL and the
# server-selected platform model after every project/user environment overlay.
# These legacy variables are not a production fallback and must not be exposed
# to the browser or saved through system_config.env_vars.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Optional model aliases consumed by Claude Code SDK.
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=

# =============================================================================
# 2. Claude Code SDK process options
# =============================================================================
# API timeout in milliseconds.
API_TIMEOUT_MS=3000000

# Disable nonessential Claude Code traffic such as telemetry.
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# =============================================================================
# 3. Claude Agent Mem0 memory
# =============================================================================
INK_AGENT_MEM0_ENABLED=true
INK_AGENT_MEM0_API_KEY=
INK_AGENT_MEM0_API_HOST=
INK_AGENT_MEM0_CONNECT_TIMEOUT_MS=1500
INK_AGENT_MEM0_READ_TIMEOUT_MS=8000
INK_AGENT_MEM0_TOP_K=10

# Set to 0/false/off to disable the memory stdio MCP server.
INK_AGENT_ENABLE_MEMORY_MCP=1

# Request-scoped values are intentionally not listed here:
# INK_AGENT_MEM0_USER_ID, INK_AGENT_USER_MESSAGE, MEM0_USER_ID.

# =============================================================================
# 4. Claude Agent session behavior
# =============================================================================
# Thread Session keepalive TTL in seconds.
INK_AGENT_TTL_S=600

# Background sweeper interval in seconds.
INK_AGENT_SWEEP_INTERVAL_S=60

# SSE keepalive comment-frame interval in seconds.
INK_AGENT_SSE_KEEPALIVE_S=15

# Maximum Agent turns per request.
INK_AGENT_MAX_TURNS=100

# Number of recent writing sessions injected into context.
INK_AGENT_CONTEXT_SESSIONS=5

# SSE EventBus backend for Claude Agent stream reconnect (memory | redis).
# memory: single-process InMemoryEventBus (default, no extra deps).
# redis:  RedisStreamEventBus for multi-worker / multi-pod deployments.
INK_AGENT_EVENT_BUS_BACKEND=memory

# Redis connection URL — required when INK_AGENT_EVENT_BUS_BACKEND=redis.
INK_AGENT_REDIS_URL=redis://localhost:6379/0

# Redis Stream key TTL (seconds) for per-turn event buffers.
INK_AGENT_EVENT_BUS_TTL_S=3600


# Optional absolute workspace root for Claude Agent runtime files.
# Leave empty to use the system temp-directory default.
AGENT_CWD=

# =============================================================================
# 4.1 Frontend deployment / CORS
# =============================================================================
# Comma-separated browser origins allowed to call this backend directly.
# Leave unset to allow the built-in local frontend defaults:
# http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173
# Production deployments should use explicit frontend origins. The Google Cloud
# deployment default is https://ink-frontend.suoxya.com.
INK_CORS_ALLOW_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173

# Set true only if the frontend intentionally sends cookies with requests.
# Bearer-token Authorization headers do not require browser credentials mode.
INK_CORS_ALLOW_CREDENTIALS=false

# =============================================================================
# 5. File storage
# =============================================================================
# Storage backend: 's3' or 'local' (default).
FILE_STORAGE_TYPE=local

# Common prefix applied to all stored file keys.
FILE_STORAGE_PREFIX=uploads

# --- S3 / S3-compatible (MinIO, DigitalOcean Spaces, …) ---
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_REGION=us-east-1
# Custom endpoint for S3-compatible services (leave empty for AWS S3).
FILE_STORAGE_S3_ENDPOINT=
# Set to 'true' for MinIO and other path-style endpoints.
FILE_STORAGE_S3_FORCE_PATH_STYLE=false
# Override the public base URL (e.g. a CDN in front of the bucket).
FILE_STORAGE_S3_PUBLIC_BASE_URL=

# --- Local filesystem backend ---
# Absolute path to the local storage directory.
# Defaults to <repo>/backend/data/file-storage when left empty.
FILE_STORAGE_LOCAL_DIR=

# =============================================================================
# 6. Admin Gateway inference (Claude Agent, Dream, Chat and Workflow)
# =============================================================================
# All runtime inference is server-side and fail-closed through Admin Gateway.
# The browser never receives these values. Model values are published Admin
# aliases, not Provider model IDs. Settings reads the current user's callable
# aliases from Admin GET /v1/models through Dream GET /api/gateway/models; a
# saved alias is revalidated before every Claude Agent turn. No direct Provider
# endpoint/key fallback is supported by Dream runtime.
INK_GATEWAY_ENABLED=0
INK_GATEWAY_BASE_URL=http://127.0.0.1:3000
INK_GATEWAY_SERVICE_KEY=
INK_GATEWAY_SUBJECT_JWT_ISSUER=ink-dream-memory
INK_GATEWAY_SUBJECT_JWT_AUDIENCE=ink-memory-admin-gateway
INK_GATEWAY_SERVICE_CLIENT_ID=ink-dream-memory
INK_GATEWAY_SUBJECT_TOKEN_LIFETIME_SECONDS=240
INK_GATEWAY_TEXT_MODEL_ALIAS=
INK_GATEWAY_IMAGE_DESCRIPTION_MODEL_ALIAS=
INK_GATEWAY_IMAGE_GENERATION_MODEL_ALIAS=

# =============================================================================
# 7. Image response tuning
# =============================================================================

# Retry / timeout tuning (optional — defaults shown).
# INK_IMAGE_RETRY_MAX_ATTEMPTS=3
# INK_IMAGE_RETRY_BASE_TIMEOUT=90
# INK_IMAGE_RETRY_TIMEOUT_INCREMENT=30
# INK_IMAGE_MAX_TOKENS=1000
# INK_IMAGE_DESCRIPTION_MAX_TOKENS=500
# INK_IMAGE_DESCRIPTION_TIMEOUT=120
