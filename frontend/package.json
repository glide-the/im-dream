{
  "name": "frontend",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "native:typecheck": "tsc --noEmit --pretty false -p tsconfig.native.json",
    "native:check-ui": "node --experimental-strip-types native-scripts/check-original-ui-contract.mjs",
    "native:prepare-fonts": "uv run --no-project --with fonttools==4.60.1 --with brotli==1.2.0 python ios/scripts/prepare-fonts.py",
    "native:bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.native.js --bundle-output ios/build/js/main.jsbundle --assets-dest ios/build/js",
    "native:ios": "bash ios/scripts/build-rn-ios.sh",
    "mobile:test": "node --test --experimental-strip-types app/_dream/platform/mobileBridge.test.ts app/_dream/platform/mobileRuntimeTransport.test.ts",
    "start": "next start",
    "build:docker": "INK_NEXT_OUTPUT=standalone next build --webpack",
    "e2e:deck": "playwright test e2e/deck-dream.spec.ts --reporter=line --workers=1",
    "e2e:claude-plugins": "playwright test e2e/claude-plugin-settings.spec.ts --reporter=line --workers=1",
    "e2e:mcp-apps-phase0": "playwright test e2e/mcp-apps/phase-0 --reporter=line --workers=1",
    "e2e:mcp-apps-phase1": "playwright test e2e/mcp-apps/phase-1 --reporter=line --workers=1",
    "test:mcp-apps-runtime": "pnpm --filter @ink-dream/mcp-apps-runtime test",
    "typecheck:mcp-apps": "pnpm --filter @ink-dream/mcp-apps-runtime typecheck && tsc --noEmit -p packages/mcp-apps-runtime/tsconfig.integration.json",
    "lint": "eslint .",
    "preview": "next start"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.193",
    "@ink-dream/mcp-apps-runtime": "workspace:*",
    "@ink-dream/sketch-input": "workspace:*",
    "@mcp-ui/client": "7.1.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tiptap/extension-highlight": "^3.6.2",
    "@tiptap/extension-placeholder": "^3.7.2",
    "@tiptap/markdown": "^3.27.1",
    "@tiptap/react": "^3.6.2",
    "@tiptap/starter-kit": "^3.6.2",
    "ai": "^6.0.191",
    "html-to-image": "^1.11.13",
    "i18next": "^24.0.0",
    "mermaid": "^11.16.0",
    "next": "16.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.0.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.15.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "text-encoding-utf-8": "1.0.2",
    "undici": "6.28.1",
    "web-streams-polyfill": "4.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "1.62.1",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/gradle-plugin": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@types/node": "22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "0.27.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "react-grab": "^0.1.37",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
