# [Input] Local Dream origins and the registered online Admin service identity.
# [Output] Secret-free complete template for pnpm dev:online.
# [Pos] Copy to private .env.online; the Node preloader loads it before Next.js reads .env.local.
# [Sync] 2026-11-09: use loadEnvFile through --import for Next.js development child compatibility.
# [Sync] 2026-11-09: separate local Web access to online Admin from the default local Admin profile.

INK_BACKEND_INTERNAL_URL=http://127.0.0.1:8765
INK_PUBLIC_SITE_URL=http://localhost:5173
INK_DREAM_PUBLIC_ORIGIN=http://localhost:5173
INK_DREAM_BFF_REDIRECT_URI=http://localhost:5173/auth/callback
INK_DREAM_BFF_COOKIE_SECRET=
INK_DREAM_BFF_LOGIN_TTL_SECONDS=600

# Match the online Admin client registration; keep both secrets server-only.
INK_ADMIN_DREAM_BASE_URL=https://ink-admin.suoxya.com
INK_ADMIN_DREAM_TRANSPORT_BASE_URL=https://ink-admin.suoxya.com
INK_ADMIN_AUTH_ISSUER=https://ink-admin.suoxya.com/api/auth
INK_DREAM_API_RESOURCE=https://ink-frontend.suoxya.com/api
INK_ADMIN_DREAM_SERVICE_CLIENT_ID=ink-dream-service
INK_ADMIN_DREAM_SERVICE_SECRET=
INK_ADMIN_DREAM_TIMEOUT_SECONDS=10
INK_ADMIN_DREAM_MAX_RESPONSE_BYTES=1048576
