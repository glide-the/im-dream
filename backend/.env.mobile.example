# [Input] backend/.env.example完整配置项及公网Admin连接示例。
# [Output] backend/.env.mobile完整配置模板，凭据在本机填写。
# [Pos] 本机移动配置模板；Admin Backend调试通过envFile读取，iOS装配读取backend/.env。
# [Sync] 2026-11-04: 复用普通模板的完整配置项，预填目标Admin连接。
# 已有backend/.env时，从该文件复制完整配置，再采用目标Admin连接和已登记凭据。

# Copy this file to backend/.env.mobile and fill real values locally. Do not commit secrets.

# Admin authentication/data consumer v1.
# All are server-owned; use one explicitly selected public origin and registered client.
# A service client has only its configured background scopes; its credential is not a user token.
INK_ADMIN_DREAM_BASE_URL=https://ink-admin.suoxya.com
# Optional server-only transport origin; defaults to the public Admin base URL.
INK_ADMIN_DREAM_TRANSPORT_BASE_URL=https://ink-admin.suoxya.com
INK_ADMIN_AUTH_ISSUER=https://ink-admin.suoxya.com/api/auth
INK_DREAM_API_RESOURCE=https://ink-frontend.suoxya.com/api
INK_ADMIN_DREAM_SERVICE_CLIENT_ID=ink-dream-local
INK_ADMIN_DREAM_SERVICE_SECRET=
INK_ADMIN_DREAM_TIMEOUT_SECONDS=10
# Full-text Session ranges are read before fuzzy ranking and result limiting.
# This byte budget also bounds the private Session broker; it is not a diary quota.
INK_ADMIN_DREAM_MAX_RESPONSE_BYTES=16777216
INK_ADMIN_JWKS_CACHE_SECONDS=300
INK_ADMIN_JWKS_REFRESH_MIN_INTERVAL_SECONDS=5

# Admin Product API transport. The request Origin requires an exact registration
# in the target Admin PRODUCT_API_ORIGIN_ALLOWLIST.
INK_ADMIN_PRODUCT_API_BASE_URL=https://ink-admin.suoxya.com
INK_ADMIN_PRODUCT_ORIGIN=http://127.0.0.1:5173
INK_ADMIN_PRODUCT_TIMEOUT_SECONDS=8

# Absolute server-owned shared filesystem root for Claude plugin CLI state,
# immutable artifacts and operation evidence. Every Dream process that consumes
# Admin installation metadata must use the same root; changing checkout must not
# silently select a new empty store. Leave empty only for a single-checkout
# deployment that intentionally uses backend/data/claude-plugin-runtime.
INK_CLAUDE_PLUGIN_RUNTIME_ROOT=

# Managed Claude MCP OAuth credentials are encrypted by Dream because they are
# Runtime connector secrets, not business-table access credentials. Provide one
# stable 32-byte key as 64 hex characters or standard base64; rotate it only via
# an explicit credential migration. The exact public SPA callback must be
# registered/configured for the deployed frontend origin.
INK_CLAUDE_MCP_CREDENTIAL_KEY=
INK_CLAUDE_MCP_CREDENTIAL_KEY_VERSION=1
INK_CLAUDE_MCP_CREDENTIAL_MAX_BYTES=1048576
INK_CLAUDE_MCP_OAUTH_REDIRECT_URI=
INK_CLAUDE_MCP_OAUTH_CLIENT_NAME=Ink & Memory Dream

# =============================================================================
# 1. Claude Code SDK compatibility variables
# =============================================================================
# Admin Gateway-enabled runtime overwrites authentication, Base URL and the
# server-selected platform model after every project/user environment overlay.
# These legacy variables are not a production fallback and must not be exposed
# to the browser or saved through system_config.env_vars.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Optional model aliases consumed by Claude Code SDK.
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=

# =============================================================================
# 2. Claude Code SDK process options
# =============================================================================
# API timeout in milliseconds.
API_TIMEOUT_MS=3000000

# Disable nonessential Claude Code traffic such as telemetry.
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Maximum bytes for one Claude CLI NDJSON stdout message. The server validates
# this value within 1–64 MiB; 8 MiB covers duplicated image Read payloads while
# retaining a bounded per-Agent memory ceiling.
INK_CLAUDE_AGENT_MAX_BUFFER_SIZE_BYTES=8388608

# =============================================================================
# 3. Claude Agent Mem0 memory
# =============================================================================
INK_AGENT_MEM0_ENABLED=true
INK_AGENT_MEM0_API_KEY=
INK_AGENT_MEM0_API_HOST=
INK_AGENT_MEM0_CONNECT_TIMEOUT_MS=1500
INK_AGENT_MEM0_READ_TIMEOUT_MS=8000
INK_AGENT_MEM0_TOP_K=10

# Legacy memory stdio MCP is disabled by default. Set to 1 only when this
# deployment explicitly provides the Ink memory capability and accepts the
# extra Python MCP process per active Agent turn.
INK_AGENT_ENABLE_MEMORY_MCP=0

# Request-scoped values are intentionally not listed here:
# INK_AGENT_MEM0_USER_ID, INK_AGENT_USER_MESSAGE, MEM0_USER_ID.

# =============================================================================
# 4. Claude Agent session behavior
# =============================================================================
# Thread Session keepalive TTL in seconds.
INK_AGENT_TTL_S=600

# Background sweeper interval in seconds; admission also exposes it as the retry
# hint. It must be a positive JSON-safe integer (1..9007199254740991).
INK_AGENT_SWEEP_INTERVAL_S=60

# Positive JSON-safe active Agent turn cap with no arbitrary product maximum. The
# default protects the current low-memory topology from multiple CLI trees.
INK_AGENT_MAX_CONCURRENT_RUNS=1

# Headroom required before spawning one Claude CLI process tree: measured
# per-turn growth budget plus memory retained for health and non-Agent requests.
# Both values must be >=1 and their MiB sum must be <=8589934591 so the byte
# calculation remains an exact JSON/TypeScript safe integer; zero is not a sentinel.
INK_AGENT_RUN_MEMORY_BUDGET_MIB=512
INK_AGENT_MEMORY_RESERVE_MIB=128

# Process-local Admin resource-policy refresh interval (1–300 seconds).
# Invalid values fall back to 5 seconds; this is not an Admin policy field.
INK_AGENT_RESOURCE_POLICY_REFRESH_INTERVAL_S=5

# SSE keepalive comment-frame interval in seconds.
INK_AGENT_SSE_KEEPALIVE_S=15

# Maximum Agent turns per request.
INK_AGENT_MAX_TURNS=100

# Server-owned Claude Bash sandbox capability. Defaults to true when omitted;
# invalid values also fail closed to true. Setting false keeps Workspace Mode
# but executes approved Bash directly as the Dream service account.
INK_AGENT_SANDBOX_ENABLED=true

# Number of recent writing sessions injected into context.
INK_AGENT_CONTEXT_SESSIONS=5

# SSE EventBus backend for Claude Agent stream reconnect (memory | redis).
# memory: single-process InMemoryEventBus (default, no extra deps).
# redis:  RedisStreamEventBus for multi-worker / multi-pod deployments.
INK_AGENT_EVENT_BUS_BACKEND=memory

# Redis connection URL — required when INK_AGENT_EVENT_BUS_BACKEND=redis.
INK_AGENT_REDIS_URL=redis://localhost:6379/0

# Redis Stream key TTL (seconds) for per-turn event buffers.
INK_AGENT_EVENT_BUS_TTL_S=3600


# Optional absolute workspace root for Claude Agent runtime files.
# Leave empty to use the system temp-directory default.
AGENT_CWD=

# Notion credentials and canonical current snapshots default to
# {parent of AGENT_CWD}/notion-runtime. They are isolated by actor below
# users/<actor-hash>/{home,snapshots}; Chat only projects the latest successful
# state to {AGENT_CWD}/{thread_id}/.notion-home and .notion. Override only with
# an absolute server-owned agentdata path; never point this at a user's HOME.
INK_NOTION_RUNTIME_ROOT=
# Optional absolute ntn executable. Empty resolves the deployment-pinned PATH entry.
# Calendar metadata and Markdown body reads require an explicit server-owned API date.
# Captured ntn 0.15.1 default and explicit --notion-version both send 2026-03-11.
# Existing .env files must add this key and restart their owned Dream backend.
# Runtime still has no fallback; verify compatibility before changing this value.
INK_NOTION_TODAY_API_VERSION=2026-03-11
# Exact HTTPS destinations allowed in Calendar metadata (no wildcard/subdomain guess).
INK_NOTION_ALLOWED_URL_HOSTS=www.notion.so,notion.so,www.notion.site,notion.site,app.notion.com
INK_NOTION_CLI_PATH=
# Per-native API read deadline in positive seconds (at most 300); timeout kills and reaps the CLI.
INK_NOTION_OPERATION_TIMEOUT_SECONDS=30
INK_NOTION_MAX_CREDENTIAL_FILE_BYTES=1048576
# Maximum canonical current-snapshot payload accepted per connector.
INK_NOTION_MAX_SNAPSHOT_BYTES=134217728
# Private complete-body candidates bridge one same-key Browser OAuth renewal.
# Technical cache bounds only; they do not grant access or change token lifetime.
# MAX_BYTES defaults to INK_NOTION_MAX_SNAPSHOT_BYTES when omitted.
INK_REFLECTIONS_SOURCE_PREPARATION_TTL_SECONDS=300
INK_REFLECTIONS_SOURCE_PREPARATION_MAX_ENTRIES=32
INK_REFLECTIONS_SOURCE_PREPARATION_MAX_BYTES=134217728
# Process-local policy sweep interval. Per-connector cadence remains server-owned
# connector policy; this value only bounds how often due policies are examined.
INK_NOTION_SYNC_SCHEDULER_INTERVAL_SECONDS=60

# =============================================================================
# 4.1 Frontend deployment / CORS
# =============================================================================
# Comma-separated browser origins allowed to call this backend directly.
# Leave unset to allow the built-in local frontend defaults:
# http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173
# Production deployments should use explicit frontend origins. The Google Cloud
# deployment default is https://ink-frontend.suoxya.com.
INK_CORS_ALLOW_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173

# Set true only if the frontend intentionally sends cookies with requests.
# Bearer-token Authorization headers do not require browser credentials mode.
INK_CORS_ALLOW_CREDENTIALS=false

# =============================================================================
# 5. File storage
# =============================================================================
# Storage backend: 's3' or 'local' (default).
FILE_STORAGE_TYPE=local

# Common prefix applied to all stored file keys.
FILE_STORAGE_PREFIX=uploads

# --- S3 / S3-compatible (MinIO, DigitalOcean Spaces, …) ---
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_REGION=us-east-1
# Custom endpoint for S3-compatible services (leave empty for AWS S3).
FILE_STORAGE_S3_ENDPOINT=
# Set to 'true' for MinIO and other path-style endpoints.
FILE_STORAGE_S3_FORCE_PATH_STYLE=false
# Override the public base URL (e.g. a CDN in front of the bucket).
FILE_STORAGE_S3_PUBLIC_BASE_URL=

# --- Local filesystem backend ---
# Absolute path to the local storage directory.
# Defaults to <repo>/backend/data/file-storage when left empty.
FILE_STORAGE_LOCAL_DIR=

# =============================================================================
# 6. Admin Gateway inference (Claude Agent, Dream, Chat and Workflow)
# =============================================================================
# All runtime inference is server-side and fail-closed through Admin Gateway.
# The browser never receives these values. Model values are published Admin
# aliases, not Provider model IDs. Settings reads the current user's callable
# aliases from Admin GET /v1/models through Dream GET /api/gateway/models; a
# saved alias is revalidated before every Claude Agent turn. No direct Provider
# endpoint/key fallback is supported by Dream runtime.
INK_GATEWAY_ENABLED=1
INK_GATEWAY_BASE_URL=https://ink-admin.suoxya.com
INK_GATEWAY_SERVICE_KEY=
INK_GATEWAY_SERVICE_CLIENT_ID=ink-dream-memory

# [Sync] 2026-10-10: server-only Images tool execution capacities; Admin owns model access and billing.
# Requires Workspace Mode, Admin Images, and the current actor/grant images:create scope.
# Image model is the user Settings image_model selection; no server alias/default fallback.
INK_IMAGE_TIMEOUT_SECONDS=600
INK_IMAGE_MAX_BYTES=33554432
INK_IMAGE_MAX_RESPONSE_BYTES=67108864
INK_IMAGE_MAX_PIXELS=50000000

# Private Reflections-derived Markdown, outside native Agent workspace read grants.
# Optional absolute root; default backend/data/memory-artifacts. Must be shared across Dream replicas.
MEMORY_ARTIFACT_ROOT=
# Technical worker polling only; not a user memory quota or behavior threshold.
MEMORY_POLL_SECONDS=2
# Bounds resolver reads; default is the Admin transport timeout.
MEMORY_RESOLVE_TIMEOUT_SECONDS=10
