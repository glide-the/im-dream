# Ink & Memory Claude Agent environment template.
# Copy this file to backend/.env and fill real values locally. Do not commit secrets.

# =============================================================================
# 1. Claude Code SDK credentials
# =============================================================================
# Use ANTHROPIC_* directly for the SDK subprocess. Leave ANTHROPIC_BASE_URL empty
# when using the official Anthropic endpoint.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-bda7e3b626954e5990b743c82ceb52a2
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro
API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING=1
CLAUDE_CODE_DISABLE_THINKING=1
MAX_THINKING_TOKENS=0
PAWKEYLAND_CLAUDE_AGENT_ALLOW_REQUEST_MODEL_OVERRIDE=false

# Optional absolute workspace root for Claude Agent runtime files.
# Leave empty to use the system temp-directory default.
AGENT_CWD=


# =============================================================================
# 2. Ink Agent runtime mapping
# =============================================================================
# Optional Ink-owned aliases. If set, these are mapped to ANTHROPIC_* for the
# Claude Code SDK subprocess and take precedence over direct ANTHROPIC_* values.
INK_AGENT_PROVIDER=env
INK_AGENT_API_KEY=
INK_AGENT_BASE_URL=
INK_AGENT_MODEL=

# thinking mode: enabled | disabled
INK_AGENT_THINKING=disabled
 

# =============================================================================
# 3. Claude Code SDK process options
# =============================================================================
# API timeout in milliseconds.
API_TIMEOUT_MS=3000000
 
# =============================================================================
# 4. Claude Agent session behavior
# =============================================================================
# Thread Session keepalive TTL in seconds.
INK_AGENT_TTL_S=600

# Background sweeper interval in seconds.
INK_AGENT_SWEEP_INTERVAL_S=60

# SSE keepalive comment-frame interval in seconds.
INK_AGENT_SSE_KEEPALIVE_S=15

# Maximum Agent turns per request.
INK_AGENT_MAX_TURNS=100

# Number of recent writing sessions injected into context.
INK_AGENT_CONTEXT_SESSIONS=5

