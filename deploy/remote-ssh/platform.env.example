# [Input] Admin container embedded-PostgreSQL contract plus Admin/Dream public HTTPS origins.
# [Output] Template for the ignored deploy/remote-ssh/.env runtime file.
# [Pos] Alibaba Cloud Dream deployment configuration template.
# [Sync] 2026-08-22: use one validated public HTTPS Admin origin for Gateway
#                    and Product API while embedded PostgreSQL stays internal.
# [Sync] 2026-08-22: add explicit ECS block-device read budgets for the Dream
#                    backend; values must be calibrated from host disk evidence.

# The password is owned by Admin. Generate this file with prepare-env.sh and an
# explicit DREAM_ADMIN_ENV_FILE; do not commit the generated .env.
DREAM_DATABASE_URL=postgresql://ink_memory:<postgres-password>@ink-memory-postgres:5432/ink-memory
DREAM_GATEWAY_ORIGIN=https://ink-admin.example.com
DREAM_PRODUCT_ORIGIN=https://ink-frontend.example.com
DREAM_FILE_STORAGE_TYPE=local
DREAM_BACKEND_BLOCK_DEVICE=/dev/vda
DREAM_BACKEND_READ_BPS=32mb
DREAM_BACKEND_READ_IOPS=400
