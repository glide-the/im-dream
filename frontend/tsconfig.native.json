{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleSuffixes": [".native", ""], "jsx": "react-jsx", "strict": true,
    "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "types": ["react", "react-native", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "app/_dream/components/*.native.tsx", "app/_dream/components/chat/*.native.tsx", "app/_dream/components/chat/*.native.ts", "app/_dream/components/deck/*.native.tsx", "app/_dream/components/dashboard/*.native.tsx", "app/_dream/components/claude-mcp/*.native.tsx", "app/_dream/components/claude-plugin-admin/*.native.tsx", "app/_dream/components/story-workspace/layout/*.native.tsx", "app/_dream/views/story-workspace/*.native.tsx"],
  "exclude": ["src/**/*.web.ts", "src/**/*.web.tsx"]
}
